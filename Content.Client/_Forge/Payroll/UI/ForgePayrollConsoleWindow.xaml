<DefaultWindow xmlns="https://spacestation14.io"
               Title="{Loc 'forge-payroll-console-title'}"
               MinSize="760 470">
    <BoxContainer Orientation="Horizontal" VerticalExpand="True">
        <BoxContainer Orientation="Vertical" MinWidth="260" MaxWidth="260" Margin="0 0 8 0">
            <Label Text="{Loc 'forge-payroll-console-crew'}" />
            <ScrollContainer VerticalExpand="True">
                <ItemList Name="RecordsList" SelectMode="Single" VerticalExpand="True" />
            </ScrollContainer>
        </BoxContainer>

        <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True">
            <Label Name="SelectionLabel" Text="{Loc 'forge-payroll-console-no-selection'}" />
            <Control MinSize="0 8" />

            <GridContainer Columns="2" HSeparationOverride="6" VSeparationOverride="6">
                <Label Text="{Loc 'forge-payroll-console-name'}" />
                <Label Name="EmployeeNameLabel" />

                <Label Text="{Loc 'forge-payroll-console-job-prototype'}" />
                <Label Name="JobPrototypeLabel" />

                <Label Text="{Loc 'forge-payroll-console-job-title'}" />
                <LineEdit Name="JobTitleLineEdit" HorizontalExpand="True" />

               <Label Text="{Loc 'forge-payroll-console-department'}" />
                <LineEdit Name="DepartmentLineEdit" HorizontalExpand="True" />

                <Label Text="{Loc 'forge-payroll-console-status'}" />
                <OptionButton Name="StatusOptionButton" HorizontalExpand="True" />

                <Label Text="{Loc 'forge-payroll-console-base-salary'}" />
                <SpinBox Name="BaseSalarySpinBox" HorizontalExpand="True" />

                <Label Text="{Loc 'forge-payroll-console-adjustment'}" />
                <SpinBox Name="AdjustmentSpinBox" HorizontalExpand="True" />

                <Label Text="{Loc 'forge-payroll-console-total'}" />
                <Label Name="TotalSalaryLabel" />

                <Label Text="{Loc 'forge-payroll-console-next-pay'}" />
                <Label Name="NextPayLabel" />

                <Label Text="{Loc 'forge-payroll-console-last-pay'}" />
                <Label Name="LastPayLabel" />

                <Label Text="{Loc 'forge-payroll-console-last-fine'}" />
                <Label Name="LastFineLabel" />

                <Label Text="{Loc 'forge-payroll-console-fine-amount'}" />
                <SpinBox Name="FineAmountSpinBox" HorizontalExpand="True" />

                <Label Text="{Loc 'forge-payroll-console-fine-reason'}" />
                <LineEdit Name="FineReasonLineEdit" HorizontalExpand="True" />
            </GridContainer>

            <Control MinSize="0 8" />
            <Control VerticalExpand="True" />

            <BoxContainer Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Name="FineButton" Text="{Loc 'forge-payroll-console-fine'}" />
                <Button Name="PayNowButton" Text="{Loc 'forge-payroll-console-pay-now'}" />
                <Button Name="SaveButton" Text="{Loc 'forge-payroll-console-save'}" />
            </BoxContainer>
        </BoxContainer>
    </BoxContainer>
</DefaultWindow>
